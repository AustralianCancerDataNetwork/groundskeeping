Screen {
    layout: vertical;
    background: $background;
}

* {
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
    scrollbar-background: $surface-darken-1;
    scrollbar-color: $primary 50%;
}

#body {
    height: 1fr;
}

#page-tabs {
    height: 1;
    background: $surface;
}

#page-tabs Underline {
    display: none;
    height: 0;
}

#workspace {
    height: 1fr;
    padding: 0 1;
}

#workspace-title {
    height: 1;
}

.operator-page {
    display: none;
}

.operator-page.-active {
    display: block;
    height: 0;
    max-height: 0;
}

#wizard-frame {
    width: 88;
    max-width: 92%;
    height: 32;
    max-height: 90%;
    margin: 2 4;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

#wizard-title {
    height: 1;
    text-style: bold;
}

#wizard-progress {
    height: 1;
    color: $text-muted;
}

#wizard-body {
    height: 1fr;
    margin-top: 1;
    margin-bottom: 1;
}

#wizard-errors {
    min-height: 1;
    max-height: 4;
    color: $text-error;
}

#wizard-buttons {
    height: 3;
    align-horizontal: right;
}

#wizard-buttons Button {
    width: 14;
    min-width: 14;
    margin-left: 1;
}

.wizard-field-label {
    height: 1;
    margin-top: 1;
    text-style: bold;
}

.wizard-field-help {
    color: $text-muted;
    margin-bottom: 1;
}

.wizard-warning {
    color: $text-warning;
}

.section {
    border: round $accent 40%;
    border-title-align: left;
    border-title-color: $text-accent 50%;
    border-subtitle-align: right;
    border-subtitle-color: $text-muted;
    padding: 0 1;
}

.section:focus-within {
    border: round $accent;
    border-title-color: $foreground;
    border-title-style: bold;
}

#workbench {
    height: 1fr;
}

#workbench-main {
    height: 1fr;
}

#catalogue-panel {
    width: 36;
    max-width: 40%;
    height: 1fr;
}

#workbench-right {
    width: 1fr;
    height: 1fr;
}

#result-panel {
    height: 3fr;
}

#context-panel {
    height: 2fr;
}

Tree, OptionList, TextArea, DataTable {
    height: 1fr;
}

#sections {
    border: none;
    background: transparent;
}

#context {
    border: none;
    background: transparent;
}

#context:focus {
    border: none;
}

#result-header {
    height: 1;
    margin-bottom: 1;
}

#result-actions {
    display: none;
    height: 3;
    layout: horizontal;
    margin-bottom: 1;
}

#result-actions Button {
    width: auto;
    min-width: 16;
    margin: 0 1 0 0;
}

#result-status {
    width: auto;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
    color: $text-muted;
    background: $surface;
}

#result-status.-ok {
    color: $text-success;
    background: $success-muted;
}

#result-status.-warning {
    color: $text-warning;
    background: $warning-muted;
}

#result-status.-error {
    color: $text-error;
    background: $error-muted;
}

#result-summary {
    width: 1fr;
    height: 1;
}

#result-empty, #result-loading {
    height: 1fr;
    hatch: right $surface-lighten-1 18%;
    color: $text-muted;
    content-align: center middle;
    text-align: center;
    padding: 0 4;
}

DataTable:blur > .datatable--cursor {
    background: transparent;
}

Tree:blur > .tree--cursor {
    background: transparent;
}

DataTable > .datatable--header {
    color: $text-accent;
    background: $surface;
}
